  "instructions": [
    {
      "name": "faucet",
      "docs": [
        "Permissionless testnet faucet. **Any** user can mint up to",
        "[`FAUCET_MAX_PER_CALL`] (10,000) MockGFOGO into their own token account",
        "so they can try the protocol without asking the admin. The `rate` PDA",
        "is the SPL mint authority and signs via CPI. A per-wallet cooldown",
        "(e.g. 2×/24h) is enforced client-side, not on-chain."
      ],
      "discriminator": [
        0,
        98,
        59,
        30,
        144,
        142,
        113,
        12
      ],
      "accounts": [
        {
          "name": "user",
          "docs": [
            "Any user may call the faucet. Signs only to prove ownership of",
            "`recipient` — pays no fee beyond the transaction itself."
          ],
          "signer": true
        },
        {
          "name": "rate",
